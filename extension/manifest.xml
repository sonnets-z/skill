<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.trae.photoshop-copilot" ExtensionBundleVersion="1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.trae.photoshop-copilot.main" Version="1.0.0"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PHSP" Version="[24.0, 30.0]"/>
            <Host Name="PHSM" Version="[24.0, 30.0]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="7.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.trae.photoshop-copilot.main">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/photoshop-actions.jsx</ScriptPath>
                    <CEFCommandLine>--enable-nodejs</CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                    <StartOn>Install</StartOn>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>
                        <Name>AI抠图助手</Name>
                        <MenuType>Panel</MenuType>
                    </Menu>
                    <Geometry>
                        <Size>
                            <Width>320</Width>
                            <Height>600</Height>
                        </Size>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>